TZ=Asia/Tehran
POSTMASTER_ADDRESS=info@asaeng.org
PERMIT_DOCKER=none
SPOOF_PROTECTION=1
SSL_TYPE=manual
SSL_CERT_PATH=/etc/asa-mail-tls/fullchain.pem
SSL_KEY_PATH=/etc/asa-mail-tls/privkey.pem
ENABLE_IMAP=1
ENABLE_POP3=0
ENABLE_CLAMAV=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
ENABLE_RSPAMD=1
ENABLE_RSPAMD_REDIS=1
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_FAIL2BAN=1
ENABLE_MANAGESIEVE=0
ENABLE_QUOTAS=1
POSTFIX_MAILBOX_SIZE_LIMIT=2147483648
POSTFIX_MESSAGE_SIZE_LIMIT=26214400
POSTFIX_INET_PROTOCOLS=ipv4
DOVECOT_INET_PROTOCOLS=ipv4
LOG_LEVEL=info
LOGROTATE_INTERVAL=daily
LOGROTATE_COUNT=7
