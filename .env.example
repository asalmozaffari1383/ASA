# Copy to .env and adjust. docker-compose reads this file automatically.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=asa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# For running the backend OUTSIDE docker, point at localhost instead of `db`:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/asa

# --- Object storage ---
# Dev: MinIO (docker-compose sets these for the web container automatically).
USE_S3=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_STORAGE_BUCKET_NAME=asa-media
# AWS_S3_ENDPOINT_URL=http://localhost:9000
# AWS_S3_ADDRESSING_STYLE=path
#
# Prod (ArvanCloud) example:
# USE_S3=true
# AWS_ACCESS_KEY_ID=your-arvan-access-key
# AWS_SECRET_ACCESS_KEY=your-arvan-secret-key
# AWS_STORAGE_BUCKET_NAME=asa-media
# AWS_S3_ENDPOINT_URL=https://s3.ir-thr-at1.arvanstorage.ir
# AWS_S3_REGION_NAME=ir-thr-at1

# --- SMS ---
# Dev: console (logs messages). Prod: kavenegar.
SMS_BACKEND=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# --- JWT (optional overrides) ---
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=7

# --- Bale bot ---
BALE_BOT_TOKEN=your-bale-bot-token
CEO_CARD_NUMBER=6037-9900-0000-0000
# BACKEND_API_URL is set to http://web:8000/api by docker-compose automatically.

# Optional build settings for networks with restricted package-host access.
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
# DOCKER_BUILD_NETWORK=host
